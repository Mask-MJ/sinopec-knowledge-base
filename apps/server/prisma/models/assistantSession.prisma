/// 会话归属表
///
/// RAGFlow 自 0.27 起把会话的 user_id 硬编码为 API key 所属用户
/// （create_session: `"user_id": current_user.id`），传入值被丢弃，
/// 它那层已无法按业务用户隔离会话。归属改由本地记录，RAGFlow 只当存储。
model AssistantSession {
  /// RAGFlow 会话ID
  sessionId   String    @id
  /// 所属助手ID
  assistantId Int
  /// 所属用户ID
  userId      Int
  /// 创建时间
  createdAt   DateTime  @default(now())
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assistantId, userId])
}
