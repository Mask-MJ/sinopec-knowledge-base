# Evaluation runner config — copy to apps/server/.env.eval and fill in.
# This file MUST point at a non-production RAGFlow environment.

# RAGFlow shadow / staging endpoint
RAGFLOW_HOST=http://staging-ragflow.example.com:9380
RAGFLOW_API_KEY=ragflow-XXXXXXXXXXXXXXXXXXXXXXXXX

# Comma-separated list of API keys that MUST NEVER be used by the eval runner
# (production keys; runner will refuse to start if matched).
RAGFLOW_PROD_KEY_BLACKLIST=ragflow-PRODKEYXXXXXXXXX,ragflow-OTHERPRODYYY
