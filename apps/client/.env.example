# Copy to apps/client/.env (gitignored) and fill in real values for local
# E2E runs against a deployed environment.
#
# Loaded by playwright.prod.config.ts via @dotenvx/dotenvx.

# Required: deployment under test.
E2E_BASE_URL=http://your-deployed-host

# Required: admin credentials for the E2E run. Use a dedicated test account,
# not a personal one — the run leaves an `e2e-manual-*` KB behind on each pass.
E2E_ADMIN_USER=admin
E2E_ADMIN_PASS=

# Optional: override the auto-generated KB name (default `e2e-manual-<ts>`).
# E2E_KB_NAME=

# Optional: ceiling for waiting on RAGFlow document parsing (ms, default 600000).
# E2E_PARSE_TIMEOUT_MS=

# Optional: which evaluation batch to run against. Corpus docs live in the
# repo-root `test-docs/<batch>/` (gitignored), the question set in
# `apps/server/scripts/eval/dataset/`. Both default to the first batch (0420).
# E2E_DOCS_DIR=test-docs/0820
# E2E_QUESTIONS_FILE=questions-0820.json
