{
  "extends": "@sinopec-kb/tsconfig/web.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./types/*"]
    }
  },
  "include": ["types/*", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"]
}
