                    <mxGeometry x="840" y="510" width="170" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="Q6" value="Dealer.search()&#xa;双路并发&#xa;FusionExpr&#xa;weighted_sum&#xa;(0.05 BM25 + 0.95 vec)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1030" y="510" width="200" height="80" as="geometry"/>
