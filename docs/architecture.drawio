    <diagram name="RAG 技术流程图" id="rag">
        <mxGraphModel dx="522" dy="751" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1080" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="T1" value="① 文档摄入流（Ingestion） — NestJS POST /datasets/{id}/documents → POST /datasets/{id}/chunks 触发异步解析" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="1660" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="I1" value="用户上传文件&#xa;(Vue 前端)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="20" y="80" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="I2" value="NestJS&#xa;KnowledgeBaseService&#xa;.uploadDocument()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="200" y="80" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="I3" value="DocxPreprocess&#xa;(pandoc 预处理 .docx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="400" y="80" width="170" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="I4" value="POST /documents&#xa;(multipart)&#xa;→ RAGFlow FileService&#xa;→ MinIO 存原文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="590" y="80" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="I5" value="POST /datasets/{id}/chunks&#xa;{document_ids:[…]}&#xa;→ task_executor 入队" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="790" y="80" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="I6" value="DeepDOC 解析&#xa;OCR + Layout + TSR&#xa;输出 sections + tables&#xa;每 box 带 page_number&#xa;/ position / layout_type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="80" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="I7" value="Chunker (chunk_method)&#xa;naive_merge / hierarchical_merge&#xa;tokenize_table&#xa;→ tokenize_chunks() 生成 ES 文档" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="80" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="I8" value="Embedding&#xa;q_{dim}_vec&#xa;写入 ES / Infinity&#xa;元数据回写 MySQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="80" width="210" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="I9" value="可选增强：RAPTOR&#xa;rag/raptor.py · GaussianMixture 聚类&#xa;LLM 摘要 → 多层向量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="190" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="I10" value="可选增强：GraphRAG&#xa;graphrag/ · 实体抽取 → entity_kwd&#xa;社区检测 → community_report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="190" width="210" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="INOTE" value="切片关键事实：&#xa;• parser_config = { layout_recognize: &#39;DeepDOC&#39;, chunk_token_num: 512, delimiter: &#39;\\n&#39;, raptor:{...}, graphrag:{...} } (sinopec-kb defaults)&#xa;• naive_merge(sections, chunk_token_num=128, delimiter=&#39;\\n。；！？&#39;, overlapped_percent=0)：按句切，按 token 上限合并，可设重叠率&#xa;• hierarchical_merge：按 BULLET_PATTERN 识别 1./1.1/(1)/一、… 等层级标题，保留章节结构&#xa;• tokenize_table：表格作独立 chunk，doc_type_kwd=&#39;table&#39;，HTML/markdown 双形式入库；图片单独存 MinIO&#xa;• 父子映射：子块在 ES 上带 mom_id 指向父块；retrieval 命中子块时通过 retrieval_by_children() 拉取父块完整内容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="20" y="280" width="1660" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="T2" value="② 问答流（Query / RAG） — Vue → NestJS POST /api/v1/chats/{id}/completions {stream:true} → SSE 透传" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="20" y="450" width="1660" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="Q1" value="用户提问&#xa;(Vue + EventSource)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
