                <mxCell id="Q8" value="retrieval_by_children&#xa;父子扩展 (mom_id → 父块)&#xa;+ GraphRAG community 扩展" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" parent="1" vertex="1">
