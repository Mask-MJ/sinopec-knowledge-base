                <mxCell id="Q7" value="Rerank（可选）&#xa;rag/llm/rerank_model.py&#xa;Jina / Xinference&#xa;cross-encoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
