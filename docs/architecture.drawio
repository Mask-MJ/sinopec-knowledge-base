                <mxCell id="Q11" value="LLM.async_chat_streamly_delta()&#xa;流式输出&#xa;含 &lt;think&gt; 段处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="480" y="620" width="230" height="80" as="geometry"/>
