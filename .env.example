# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Client (Vite)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 启动端口
VITE_PORT=3100
# 路径前缀
VITE_BASE=/
# 全局接口前缀
VITE_GLOB_API_URL_PREFIX=/api/
# 代理地址
VITE_PROXY=http://localhost:3001/api
# 应用标题
VITE_APP_TITLE=Sinopec Knowledge Base
# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=sinopec-kb
# 对store进行加密的密钥
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key
# 是否启用 Vue DevTools
VITE_DEVTOOLS=true
# 构建时是否生成依赖分析报告
VITE_VISUALIZER=false
# 是否注入首屏加载动画
VITE_INJECT_APP_LOADING=true
# 开发环境登录自动填充（仅开发，不要提交到生产 .env）
# VITE_DEV_USERNAME=admin
# VITE_DEV_PASSWORD=admin123

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Server — Application
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
APP_NAME=Sinopec Knowledge Base
APP_PORT=3001
APP_PREFIX=api
APP_LOG_ON=true
APP_CORS=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Authentication & Security
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
AUTH_BCRYPT_SALT=10
# @secret — JWT signing key (generate: uuidgen)
AUTH_JWT_SECRET=
# Token TTL in seconds (10h)
AUTH_JWT_ACCESS_TOKEN_TTL=36000
# Refresh token TTL in seconds (24h)
AUTH_JWT_REFRESH_TOKEN_TTL=86400

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Database (PostgreSQL)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=sinopec
DATABASE_USER=postgres
# @secret
DATABASE_PASSWORD=
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_DB}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Redis
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
REDIS_HOST=localhost
REDIS_PORT=6379
# @secret
REDIS_PASSWORD=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Minio (Object Storage)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CLIENT_PORT=9001
MINIO_ROOT_USER=minioadmin
# @secret
MINIO_ROOT_PASSWORD=
# @secret
MINIO_ACCESS_KEY=
# @secret
MINIO_SECRET_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  RAGFlow
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RAGFLOW_HOST=http://localhost:9380
# @secret
RAGFLOW_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Weekly Report（周报生成服务，对方团队提供）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 可不配：留空时服务照常启动，只有周报接口返回「周报服务未配置」。
# 填生成接口的完整地址。注意 docker compose 部署时后端跑在容器里，
# 127.0.0.1 / localhost 指的是 app 容器自己，不是宿主机：
#   - 对方服务在宿主机上：用宿主机内网 IP，或 host.docker.internal（Linux 需给 app 加 extra_hosts: host-gateway）
#   - 对方服务在另一台机器上：直接写那台机器的 IP / 域名
# 本机 pnpm dev:server 直接跑时才可以用 127.0.0.1。
WEEKLY_REPORT_URL=http://127.0.0.1:8001/generate_report
# @secret
WEEKLY_REPORT_API_KEY=
# 单次生成超时（秒），默认 300，最大 590（要比 nginx /api/ 的 600 秒读超时短）
# WEEKLY_REPORT_TIMEOUT_SECONDS=300

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Docker Compose (仅 docker compose 使用)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NGINX_PORT=80

# 构建镜像时用的国内源（内网机按实测填，留空用默认）
ALPINE_MIRROR=mirrors.bfsu.edu.cn
NPM_REGISTRY=
